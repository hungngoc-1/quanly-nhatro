APP_NAME="Quản Lý Nhà Trọ"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/quanly-nhatro

# Cấu hình MySQL trên WAMP (Mặc định user: root, password rỗng)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quanly_nhatro
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Đơn giá mặc định (VNĐ)
DEFAULT_ELECTRIC_RATE=3500
DEFAULT_WATER_RATE=15000
DEFAULT_SERVICE_FEE=150000
