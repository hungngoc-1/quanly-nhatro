{
    "name": "nhatro/quanly-nhatro",
    "description": "Hệ thống Quản lý Nhà trọ MVC PHP sử dụng WAMP Server",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/CoreHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/ContractTest.php",
            "@php tests/UtilityTest.php",
            "@php tests/InvoiceTest.php"
        ]
    }
}
